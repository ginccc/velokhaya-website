---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Velokhaya Life Cycling Academy | Cycling with a Purpose | Khayelitsha"
  description="Developing athletic and personal excellence through cycling, education, and nutrition. Building champions on and off the bike in Khayelitsha."
  canonicalPath="/"
>
  <Fragment slot="schema">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "Velokhaya Life Cycling Academy",
      "alternateName": "Velokhaya",
      "url": "https://velokhaya.com",
      "logo": "https://velokhaya.com/images/logo.png",
      "description": "A high-performance cycling academy in Khayelitsha developing athletes through cycling, education, and nutrition.",
      "foundingDate": "2003",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "40 Makabeni Road, Village 1 North",
        "addressLocality": "Khayelitsha",
        "addressRegion": "Western Cape",
        "postalCode": "7784",
        "addressCountry": "ZA"
      },
      "sameAs": [
        "https://www.facebook.com/Velokhaya",
        "https://twitter.com/Velokhaya",
        "https://www.instagram.com/velokhaya"
      ]
    }
    </script>
  </Fragment>

    <!-- Hero Section -->
        <div class="relative min-h-screen xl:min-h-0 xl:h-[min(100vh,900px)] flex items-center justify-center overflow-hidden pt-32 md:pt-48 pb-32">
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-gradient-to-r from-brand-black via-brand-black/80 to-brand-black/20 z-10">
                </div>
                <img src="/images/hero-riders.jpg" alt="Velokhaya cyclists riding in formation through Khayelitsha"
                    class="w-full h-full object-cover object-[center_20%] md:object-[center_30%] lg:object-[center_25%]">
            </div>
            <div class="relative z-20 max-w-7xl mx-auto px-6 sm:px-8 lg:px-8 w-full">
                <div class="max-w-3xl">
                    <div class="hidden md:flex items-center gap-4 mb-6">
                        <span class="h-1 w-12 bg-brand-yellow"></span>
                        <span class="text-brand-yellow font-bold tracking-widest uppercase text-sm">CYCLING, DONE WITH INTENTION</span>
                    </div>
                    <h1 class="text-5xl sm:text-6xl md:text-8xl font-black leading-tight mb-6 md:mb-8">
                        BUILDING<br> CHAMPIONS<br> <span class="text-brand-red">ON AND OFF THE BIKE</span>
                    </h1>
                    <p class="text-base sm:text-lg md:text-2xl text-gray-300 mb-6 md:mb-10 max-w-xl leading-relaxed md:leading-loose">
                        Developing athletic and personal excellence through cycling, education, and nutrition.
                    </p>
                    <div class="flex flex-col md:flex-row items-stretch md:items-start gap-4">
                        <a href="/support/"
                            class="flex justify-center items-center w-full md:w-64 px-8 py-4 bg-brand-red border border-transparent text-white font-bold rounded-full hover:bg-brand-blue hover:text-brand-black transition-all shadow-lg shadow-brand-red/25 text-base whitespace-nowrap">
                            RIDE WITH VELOKHAYA
                        </a>
                        <a href="/contact/"
                            class="flex justify-center items-center w-full md:w-64 px-8 py-4 bg-black border border-white/20 hover:bg-brand-red hover:text-brand-black text-white font-bold rounded-full transition-all text-base whitespace-nowrap">
                            VISIT THE ACADEMY
                        </a>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce text-gray-500">
                <i data-lucide="chevron-down" class="w-8 h-8"></i>
            </div>
        </div>

        <!-- The Peloton Metaphor -->
        <section class="py-16 md:py-24 bg-brand-dark relative overflow-hidden">
            <div class="absolute top-0 right-0 w-1/3 h-full bg-brand-blue/5 skew-x-12 transform translate-x-20"></div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black mb-4 sm:mb-6">MOVING <span class="text-brand-red">TOGETHER</span></h2>
                        <p class="text-gray-400 text-base sm:text-lg mb-4 sm:mb-6 leading-relaxed">
                            Progress in cycling is rarely made alone. Training environments matter. Standards matter. Community matters.
                        </p>
                        <p class="text-gray-400 text-base sm:text-lg mb-6 sm:mb-8 leading-relaxed">
                            Velokhaya is built around shared effort. Athletes train alongside peers, supported by coaches, educators, and systems that value consistency and accountability. Momentum is created through repetition, discipline, and collective focus, day after day.
                        </p>
                        <div class="grid grid-cols-3 gap-4 sm:gap-8 border-t border-white/10 pt-6 sm:pt-8">
                            <div>
                                <span class="block text-3xl sm:text-4xl font-black text-brand-yellow">20+</span>
                                <span class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider">Years</span>
                            </div>
                            <div>
                                <span class="block text-3xl sm:text-4xl font-black text-brand-blue">3</span>
                                <span class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider">Pillars of Impact</span>
                            </div>
                            <div>
                                <span class="block text-3xl sm:text-4xl font-black text-brand-red">1</span>
                                <span class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider">Peloton Family</span>
                            </div>
                        </div>
                    </div>
                    <div
                        class="relative h-96 w-full rounded-2xl shadow-2xl border border-white/10 overflow-hidden group">
                        <img src="/images/peloton-rider.jpg" alt="Velokhaya rider in team kit ready to ride"
                            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        <div class="absolute bottom-4 right-6 text-right">
                            <p class="text-brand-yellow font-black text-xl tracking-tighter uppercase">The Peloton</p>
                            <p class="text-xs text-gray-500 font-mono">MOVING AS ONE</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Partners -->
        <section class="py-16 md:py-24 bg-brand-black border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 text-center">
                <div class="max-w-3xl mx-auto mb-16">
                    <h2 class="text-xl sm:text-2xl font-bold text-white mb-4">OUR PARTNERS AND <span
                            class="text-brand-yellow">SUPPORTERS</span></h2>
                    <p class="text-gray-400 leading-relaxed mb-6">
                        We work with a range of organisations who have supported Velokhaya over time.
                    </p>
                </div>

                <div class="mb-12">
                    <p class="text-sm text-gray-500 uppercase tracking-widest mb-8">Current Partners</p>
                    <div
                        class="flex flex-wrap justify-center items-center gap-6 sm:gap-8 md:gap-12 opacity-80 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500">
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Avis</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Isuzu</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Cape Town Cycle Tour Trust</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Oakley</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Ciovita</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Southern Sun Hotels</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Jaecoo</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Coca-Cola Peninsula Beverages</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-lg sm:text-xl md:text-2xl font-black text-white">Prime Cleaning Supplies</span>
                        </div>
                    </div>
                </div>


            </div>
        </section>

        <!-- Latest News -->
        <section class="py-16 md:py-24 bg-brand-black border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6 sm:px-6 lg:px-8">
                <div class="flex justify-between items-end mb-12">
                    <div>
                        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black mb-2">LATEST FROM THE <span
                                class="text-brand-yellow">TRACK</span></h2>
                        <p class="text-gray-400">Stories of resilience and victory.</p>
                    </div>
                    <a href="#"
                        class="hidden md:flex items-center gap-2 text-brand-red font-bold hover:text-white transition-colors">
                        View All News <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- News Item 1 -->
                    <div class="group cursor-pointer">
                        <div class="aspect-[4/3] bg-gray-800 rounded-xl overflow-hidden mb-4 relative">
                            <div
                                class="absolute inset-0 bg-brand-red/20 group-hover:bg-transparent transition-colors z-10">
                            </div>
                            <div class="w-full h-full bg-gray-700 flex items-center justify-center text-gray-500">
                                <i data-lucide="trophy" class="w-12 h-12"></i>
                            </div>
                        </div>
                        <p class="text-brand-yellow text-xs font-bold uppercase tracking-wider mb-2">Global Stage</p>
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-red transition-colors">Anita
                            Zenani Ranks World #6</h3>
                        <p class="text-gray-500 text-sm line-clamp-2">Shattering stereotypes, our very own Anita Zenani
                            takes the world stage in Denmark, proving Khayelitsha talent is world-class.</p>
                    </div>

                    <!-- News Item 2 -->
                    <div class="group cursor-pointer">
                        <div class="aspect-[4/3] bg-gray-800 rounded-xl overflow-hidden mb-4 relative">
                            <div
                                class="absolute inset-0 bg-brand-blue/20 group-hover:bg-transparent transition-colors z-10">
                            </div>
                            <div class="w-full h-full bg-gray-700 flex items-center justify-center text-gray-500">
                                <i data-lucide="hammer" class="w-12 h-12"></i>
                            </div>
                        </div>
                        <p class="text-brand-blue text-xs font-bold uppercase tracking-wider mb-2">Campaign</p>
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-blue transition-colors">
                            Cycle for Change 2026</h3>
                        <p class="text-gray-500 text-sm line-clamp-2">We are raising R3m to upgrade our container
                            facilities into a high-performance indoor training centre.</p>
                    </div>

                    <!-- News Item 3 -->
                    <div class="group cursor-pointer">
                        <div class="aspect-[4/3] bg-gray-800 rounded-xl overflow-hidden mb-4 relative">
                            <div
                                class="absolute inset-0 bg-brand-yellow/20 group-hover:bg-transparent transition-colors z-10">
                            </div>
                            <div class="w-full h-full bg-gray-700 flex items-center justify-center text-gray-500">
                                <i data-lucide="heart-handshake" class="w-12 h-12"></i>
                            </div>
                        </div>
                        <p class="text-white text-xs font-bold uppercase tracking-wider mb-2">Alumni</p>
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-brand-yellow transition-colors">
                            Nic Dlamini Gives Back</h3>
                        <p class="text-gray-500 text-sm line-clamp-2">The Olympian returns to his roots, mentoring the
                            next generation of 'Roadies' on the very streets where he started.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonial Section -->
        <section class="py-16 md:py-24 bg-brand-black border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-black mb-4">VOICES FROM THE <span
                            class="text-brand-yellow">PELOTON</span></h2>
                    <p class="text-gray-400">What our alumni and supporters say.</p>
                </div>

                <div class="bg-brand-dark rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-12 border border-white/10 relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-32 h-32 bg-brand-yellow/10 rounded-full blur-3xl -ml-16 -mt-16">
                    </div>
                    <div class="relative z-10">
                        <i data-lucide="quote" class="w-10 h-10 sm:w-12 sm:h-12 text-brand-yellow/30 mb-4 sm:mb-6"></i>
                        <blockquote class="text-lg sm:text-xl md:text-2xl text-white font-medium leading-relaxed mb-6 sm:mb-8">
                            "Velokhaya was a place of structure and accountability. 
                            Coaches expected commitment, focus, and consistency, whether we were training or studying. 
                            That environment helped prepare me for competing at the highest level."
                        </blockquote>
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 rounded-full bg-gray-800 overflow-hidden">
                                <img src="/images/hof-nic.png" alt="Nicholas Dlamini" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <p class="font-bold text-white">Nicholas Dlamini</p>
                                <p class="text-sm text-brand-yellow">Olympian & First Black South African in Tour de
                                    France</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-24 bg-brand-dark border-t border-white/5" itemscope itemtype="https://schema.org/FAQPage">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-black mb-12 text-center">WHAT YOU NEED TO <span
                        class="text-brand-yellow">KNOW</span></h2>

                <div class="space-y-4">
                    <!-- FAQ Item 1 -->
                    <div class="border border-white/10 rounded-lg bg-brand-black overflow-hidden" itemscope
                        itemprop="mainEntity" itemtype="https://schema.org/Question">
                        <details class="group">
                            <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
                                <span class="font-bold text-lg text-white" itemprop="name">How can I join
                                    Velokhaya?</span>
                                <span class="transition group-open:rotate-180">
                                    <i data-lucide="chevron-down" class="w-5 h-5 text-brand-yellow"></i>
                                </span>
                            </summary>
                            <div class="px-6 pb-6 text-gray-400 leading-relaxed" itemscope itemprop="acceptedAnswer"
                                itemtype="https://schema.org/Answer">
                                <div itemprop="text">
                                    Young people who are interested in cycling and committed to their education can apply to join Velokhaya. Entry is based on interest, commitment, and readiness to engage with both training and learning.
                                </div>
                            </div>
                        </details>
                    </div>

                    <!-- FAQ Item 2 -->
                    <div class="border border-white/10 rounded-lg bg-brand-black overflow-hidden" itemscope
                        itemprop="mainEntity" itemtype="https://schema.org/Question">
                        <details class="group">
                            <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
                                <span class="font-bold text-lg text-white" itemprop="name">Do you accept bike
                                    donations?</span>
                                <span class="transition group-open:rotate-180">
                                    <i data-lucide="chevron-down" class="w-5 h-5 text-brand-yellow"></i>
                                </span>
                            </summary>
                            <div class="px-6 pb-6 text-gray-400 leading-relaxed" itemscope itemprop="acceptedAnswer"
                                itemtype="https://schema.org/Answer">
                                <div itemprop="text">
                                    We accept bicycles, cycling equipment, and components that meet our programme needs and safety standards. Please contact us to arrange a drop off.
                                </div>
                            </div>
                        </details>
                    </div>

                    <!-- FAQ Item 3 -->
                    <div class="border border-white/10 rounded-lg bg-brand-black overflow-hidden" itemscope
                        itemprop="mainEntity" itemtype="https://schema.org/Question">
                        <details class="group">
                            <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
                                <span class="font-bold text-lg text-white" itemprop="name">How can I support the academy
                                    financially?</span>
                                <span class="transition group-open:rotate-180">
                                    <i data-lucide="chevron-down" class="w-5 h-5 text-brand-yellow"></i>
                                </span>
                            </summary>
                            <div class="px-6 pb-6 text-gray-400 leading-relaxed" itemscope itemprop="acceptedAnswer"
                                itemtype="https://schema.org/Answer">
                                <div itemprop="text">
                                    Individuals and organisations can support Velokhaya through monthly contributions, programme support, or strategic partnerships. Visit our <a href="/support/" class="text-brand-red hover:underline">Support page</a> for more details.
                                </div>
                            </div>
                        </details>
                    </div>

                    <!-- FAQ Item 4 -->
                    <div class="border border-white/10 rounded-lg bg-brand-black overflow-hidden" itemscope
                        itemprop="mainEntity" itemtype="https://schema.org/Question">
                        <details class="group">
                            <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
                                <span class="font-bold text-lg text-white" itemprop="name">Where is Velokhaya
                                    located?</span>
                                <span class="transition group-open:rotate-180">
                                    <i data-lucide="chevron-down" class="w-5 h-5 text-brand-yellow"></i>
                                </span>
                            </summary>
                            <div class="px-6 pb-6 text-gray-400 leading-relaxed" itemscope itemprop="acceptedAnswer"
                                itemtype="https://schema.org/Answer">
                                <div itemprop="text">
                                    We are based at 40 Makabeni Road, Village 1 North, Khayelitsha, Cape Town, 7784.
                                </div>
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </section>
</BaseLayout>
