---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Support Velokhaya | Donate & Partner | Cycling NGO"
  description="Behind every strong programme is a group of people who believe in consistency, discipline, and long term development. Ride with Velokhaya by supporting our work."
  canonicalPath="/support/"
>
    <!-- Header -->
    <header class="pt-40 pb-20 bg-brand-dark relative overflow-hidden" style="padding-top: 10rem;">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-yellow/5 to-transparent"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <h1 class="text-5xl md:text-7xl font-black mb-6">RIDE WITH <span class="text-brand-yellow">VELOKHAYA</span>
            </h1>
            <p class="text-xl text-gray-400 max-w-2xl border-l-4 border-brand-yellow pl-6">
                Behind every strong programme is a group of people who believe in consistency, discipline, and long term development.
            </p>
        </div>
    </header>

    <!-- Donation Tiers -->
    <section class="py-24 bg-brand-black">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                <!-- Tier 1: Monthly Programme Support (Blue) -->
                <div
                    class="bg-brand-dark p-8 rounded-3xl border border-white/5 hover:border-brand-blue/50 transition-all flex flex-col group">
                    <div class="mb-6">
                        <i data-lucide="users"
                            class="w-12 h-12 text-brand-blue mb-4 group-hover:scale-110 transition-transform"></i>
                        <h3 class="text-2xl font-bold text-white">MONTHLY PROGRAMME SUPPORT</h3>
                        <p class="text-gray-400 mt-2">Support the work that happens every day.</p>
                    </div>
                    <div class="my-6">
                        <span class="text-4xl font-black text-white">R200</span><span
                            class="text-gray-500">/month</span>
                    </div>
                    <p class="text-gray-300 text-sm mb-8 flex-grow">
                        Your contribution supports the core operations of Velokhaya's sport, education, and nutrition programmes.
                    </p>
                    <a href="#"
                        class="w-full py-4 bg-white/10 hover:bg-brand-blue hover:text-white text-white font-bold rounded-xl transition-all text-center">Support Monthly</a>
                </div>

                <!-- Tier 2: Development Pathway Support (Yellow - Featured) -->
                <div
                    class="bg-brand-dark p-8 rounded-3xl border-2 border-brand-yellow relative transform md:-translate-y-4 shadow-2xl shadow-brand-yellow/10 flex flex-col">
                    <div
                        class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-brand-yellow text-brand-black px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wide">
                        Recommended
                    </div>
                    <div class="mb-6">
                        <i data-lucide="rocket" class="w-12 h-12 text-brand-yellow mb-4"></i>
                        <h3 class="text-2xl font-bold text-white">DEVELOPMENT PATHWAY SUPPORT</h3>
                        <p class="text-gray-400 mt-2">Contribute at a deeper level to long term athlete development.</p>
                    </div>
                    <div class="my-6">
                        <span class="text-4xl font-black text-white">R1,000</span><span
                            class="text-gray-500">/month</span>
                    </div>
                    <p class="text-gray-300 text-sm mb-4 flex-grow">
                        This option supports the full set of inputs required for athletes to train, study, and compete over time.
                    </p>
                    <p class="text-brand-yellow text-sm mb-8">
                        <i data-lucide="star" class="w-4 h-4 inline"></i> Includes one annual online briefing with Velokhaya leadership.
                    </p>
                    <a href="#"
                        class="w-full py-4 bg-brand-yellow text-brand-black font-bold rounded-xl hover:bg-white hover:text-brand-black transition-all text-center shadow-lg">Become a Development Pathway Supporter</a>
                </div>

                <!-- Tier 3: Corporate Partnerships (Red) -->
                <div
                    class="bg-brand-dark p-8 rounded-3xl border border-white/5 hover:border-brand-red/50 transition-all flex flex-col group">
                    <div class="mb-6">
                        <i data-lucide="briefcase"
                            class="w-12 h-12 text-brand-red mb-4 group-hover:scale-110 transition-transform"></i>
                        <h3 class="text-2xl font-bold text-white">CORPORATE PARTNERSHIPS</h3>
                        <p class="text-gray-400 mt-2">Partner with a proven, long term development programme.</p>
                    </div>
                    <div class="my-6">
                        <span class="text-4xl font-black text-white">Custom</span>
                    </div>
                    <p class="text-gray-300 text-sm mb-8 flex-grow">
                        We work with organisations seeking meaningful engagement aligned with sport, youth development, and measurable outcomes.
                    </p>
                    <div class="space-y-3">
                        <a href="#"
                            class="block w-full py-4 bg-white/10 hover:bg-brand-red hover:text-white text-white font-bold rounded-xl transition-all text-center">Download Partnership Overview</a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- One-Time Payment Section -->
    <section class="py-24 bg-brand-black border-t border-white/10">
        <div class="max-w-3xl mx-auto px-4 text-center">
            <div class="mb-6">
                <i data-lucide="credit-card" class="w-12 h-12 text-brand-yellow mx-auto mb-4"></i>
                <h2 class="text-3xl font-bold mb-4">One-Time Payment</h2>
                <p class="text-gray-400 mb-8">Make a secure one-time donation via credit or debit card.</p>
            </div>
            <a href="https://pay.yoco.com/velokhaya" target="_blank" rel="noopener noreferrer"
                class="inline-block px-8 py-4 bg-brand-yellow text-brand-black font-bold rounded-xl hover:bg-white transition-all shadow-lg">
                Donate Now via Card
                <i data-lucide="external-link" class="w-4 h-4 inline ml-2"></i>
            </a>
        </div>
    </section>

    <!-- Bank Details -->
    <section class="py-24 bg-brand-gray">
        <div class="max-w-3xl mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold mb-8">Direct Bank Transfer</h2>
            <div class="bg-brand-black p-8 rounded-2xl border border-white/10 text-left inline-block w-full">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <p class="text-gray-500 text-sm uppercase tracking-wider mb-1">Bank</p>
                        <p class="text-white font-mono text-lg">Standard Bank</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm uppercase tracking-wider mb-1">Account Name</p>
                        <p class="text-white font-mono text-lg">Velokhaya Cycling Academy</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm uppercase tracking-wider mb-1">Account Number</p>
                        <p class="text-white font-mono text-lg">07 123 456 7</p>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm uppercase tracking-wider mb-1">Branch Code</p>
                        <p class="text-white font-mono text-lg">020909</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
