---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heart from '@lucide/astro/icons/heart';
import Briefcase from '@lucide/astro/icons/briefcase';
import ExternalLink from '@lucide/astro/icons/external-link';
---

<BaseLayout
  title="Support Velokhaya | Donate & Partner | Cycling NGO"
  description="Behind every strong programme is a group of people who believe in consistency, discipline, and long term development. Ride with Velokhaya by supporting our work."
  canonicalPath="/support/"
>
    <!-- Header -->
    <header class="pt-40 pb-20 bg-brand-dark relative overflow-hidden" style="padding-top: 10rem;">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-yellow/5 to-transparent"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <h1 class="text-5xl md:text-7xl font-black mb-6">RIDE WITH <span class="text-brand-yellow">VELOKHAYA</span>
            </h1>
            <p class="text-xl text-gray-400 max-w-2xl border-l-4 border-brand-yellow pl-6">
                Behind every strong programme is a group of people who believe in consistency, discipline, and long term development.
            </p>
        </div>
    </header>

    <!-- Ways to Support -->
    <section class="py-24 bg-brand-black">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <!-- Make a Donation (Featured) -->
                <div
                    class="bg-brand-dark p-8 rounded-3xl border-2 border-brand-yellow shadow-2xl shadow-brand-yellow/10 flex flex-col">
                    <div class="mb-6">
                        <Heart class="w-12 h-12 text-brand-yellow mb-4" />
                        <h2 class="text-2xl font-bold text-white">MAKE A DONATION</h2>
                        <p class="text-gray-400 mt-2">Support the work that happens every day.</p>
                    </div>
                    <p class="text-gray-300 text-sm mb-4 flex-grow">
                        Your contribution supports the core operations of Velokhaya's sport, education, and nutrition
                        programmes — structured training, academic support, and daily meals for our athletes.
                    </p>
                    <p class="text-gray-500 text-sm mb-8">
                        Donations are processed as a secure once-off card payment via Yoco.
                    </p>
                    <a href="https://pay.yoco.com/velokhaya" target="_blank" rel="noopener noreferrer"
                        class="w-full py-4 bg-brand-yellow text-brand-black font-bold rounded-xl hover:bg-white transition-all text-center shadow-lg">
                        Donate Now via Card
                        <ExternalLink class="w-4 h-4 inline ml-1" />
                    </a>
                </div>

                <!-- Corporate Partnerships -->
                <div
                    class="bg-brand-dark p-8 rounded-3xl border border-white/5 hover:border-brand-red/50 transition-all flex flex-col group">
                    <div class="mb-6">
                        <Briefcase
                            class="w-12 h-12 text-brand-red mb-4 group-hover:scale-110 transition-transform" />
                        <h2 class="text-2xl font-bold text-white">CORPORATE PARTNERSHIPS</h2>
                        <p class="text-gray-400 mt-2">Partner with a proven, long term development programme.</p>
                    </div>
                    <p class="text-gray-300 text-sm mb-8 flex-grow">
                        We work with organisations seeking meaningful engagement aligned with sport, youth development,
                        and measurable outcomes.
                    </p>
                    <a href="/contact/"
                        class="block w-full py-4 bg-white/10 hover:bg-brand-red hover:text-white text-white font-bold rounded-xl transition-all text-center">Discuss a Partnership</a>
                </div>

            </div>

            <p class="text-gray-500 text-sm text-center mt-12">
                Prefer another way to support — bike donations, volunteering, or something else?
                <a href="/contact/" class="text-brand-red hover:underline">Contact us</a> and we'll find the right fit.
            </p>
        </div>
    </section>
</BaseLayout>
