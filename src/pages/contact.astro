---
import BaseLayout from '../layouts/BaseLayout.astro';
import Facebook from '../components/icons/Facebook.astro';
import Twitter from '../components/icons/Twitter.astro';
import Instagram from '../components/icons/Instagram.astro';
import Linkedin from '../components/icons/Linkedin.astro';
import MapPin from '@lucide/astro/icons/map-pin';
import Clock from '@lucide/astro/icons/clock';
import Map from '@lucide/astro/icons/map';
import Mail from '@lucide/astro/icons/mail';
import Newspaper from '@lucide/astro/icons/newspaper';
import Phone from '@lucide/astro/icons/phone';
import Send from '@lucide/astro/icons/send';

const siteUrl = (Astro.site ?? new URL('https://velokhaya.labs.ai')).href.replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: 'Velokhaya Life Cycling Academy',
  image: `${siteUrl}/images/logo.png`,
  telephone: '+27 21 361 3456',
  email: 'sipho@velokhaya.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '40 Makabeni Road, Village 1 North',
    addressLocality: 'Khayelitsha',
    addressRegion: 'Western Cape',
    postalCode: '7784',
    addressCountry: 'ZA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -34.0386,
    longitude: 18.673,
  },
  url: `${siteUrl}/contact/`,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
};
---

<BaseLayout
  title="Contact Velokhaya | Visit Us in Khayelitsha | Cape Town"
  description="Whether you want to visit the academy, discuss a partnership, or learn more about our programmes—we're here to help. Contact Velokhaya Life Cycling Academy."
  canonicalPath="/contact/"
  ogImage="/images/map-bg.jpg"
>
  <Fragment slot="schema">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

    <!-- Header -->
    <header class="pt-40 pb-16 bg-brand-dark relative overflow-hidden" style="padding-top: 10rem;">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-red/5 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-red/5 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex items-center gap-4 mb-6">
                <span class="h-1 w-12 bg-brand-red"></span>
                <span class="text-brand-red font-bold tracking-widest uppercase text-sm">Contact Us</span>
            </div>
            <h1 class="text-5xl md:text-7xl font-black mb-6">CONTACT <span class="text-brand-red">VELOKHAYA</span></h1>
            <p class="text-xl text-gray-400 max-w-2xl border-l-4 border-brand-red pl-6">
                Whether you want to visit the academy, discuss a partnership, or learn more about our programmes—we're here to help.
            </p>
        </div>
    </header>

    <!-- Contact Content -->
    <section class="py-20 bg-brand-black">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
                
                <!-- Contact Info -->
                <div>
                    <h2 class="text-3xl font-bold mb-3">Visit the Academy</h2>
                    <p class="text-gray-500 mb-8">Our doors are open to anyone who wants to see what we're building.</p>
                    
                    <!-- Address Card - Featured -->
                    <div class="p-6 bg-brand-dark rounded-2xl border border-white/10 mb-8">
                        <div class="flex items-start gap-4">
                            <div class="bg-brand-red/20 p-3 rounded-xl">
                                <MapPin class="w-6 h-6 text-brand-red" />
                            </div>
                            <div>
                                <h3 class="font-bold text-lg text-white mb-2">Address</h3>
                                <p class="text-gray-400 leading-relaxed">40 Makabeni Road<br>Village 1 North<br>Khayelitsha, Cape Town<br>7784</p>
                            </div>
                        </div>
                        
                        <!-- Opening Hours inline -->
                        <div class="mt-6 pt-6 border-t border-white/10">
                            <div class="flex items-center gap-2 mb-3">
                                <Clock class="w-4 h-4 text-gray-500" />
                                <span class="text-sm text-gray-500 font-medium">Opening Hours</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3 text-sm">
                                <div>
                                    <p class="text-gray-500">Mon - Fri</p>
                                    <p class="text-white">09:00 - 17:00</p>
                                </div>
                                <div>
                                    <p class="text-gray-500">Saturday</p>
                                    <p class="text-white">08:00 - 12:00</p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Map Button -->
                        <a href="https://maps.app.goo.gl/7QLGLsUwiUVKsEKi8" target="_blank" rel="noopener noreferrer" class="mt-6 w-full flex items-center justify-center gap-2 bg-brand-red/10 hover:bg-brand-red text-brand-red hover:text-white px-6 py-3 rounded-xl font-bold transition-all">
                            <Map class="w-5 h-5" />
                            <span>Open in Maps</span>
                        </a>
                    </div>

                    <!-- Contact Methods - Compact Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <a href="mailto:sipho@velokhaya.com" class="flex items-center gap-3 p-4 rounded-xl border border-white/10 hover:border-brand-red/30 hover:bg-brand-dark transition-all group">
                            <div class="bg-brand-red/10 p-2.5 rounded-lg group-hover:bg-brand-red/20 transition-colors">
                                <Mail class="w-5 h-5 text-brand-red" />
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">General & Partnerships</p>
                                <p class="text-sm text-white font-medium">sipho@velokhaya.com</p>
                            </div>
                        </a>

                        <a href="mailto:media@velokhaya.com" class="flex items-center gap-3 p-4 rounded-xl border border-white/10 hover:border-brand-yellow/30 hover:bg-brand-dark transition-all group">
                            <div class="bg-brand-yellow/10 p-2.5 rounded-lg group-hover:bg-brand-yellow/20 transition-colors">
                                <Newspaper class="w-5 h-5 text-brand-yellow" />
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Media & PR</p>
                                <p class="text-sm text-white font-medium">media@velokhaya.com</p>
                            </div>
                        </a>

                        <a href="tel:+27213613456" class="flex items-center gap-3 p-4 rounded-xl border border-white/10 hover:border-brand-red/30 hover:bg-brand-dark transition-all group">
                            <div class="bg-brand-red/10 p-2.5 rounded-lg group-hover:bg-brand-red/20 transition-colors">
                                <Phone class="w-5 h-5 text-brand-red" />
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Phone</p>
                                <p class="text-sm text-white font-medium">+27 21 361 3456</p>
                            </div>
                        </a>
                    </div>
                </div>
                <!-- Contact Form -->
                <div class="bg-brand-dark p-8 md:p-10 rounded-3xl border border-white/10 relative overflow-hidden h-fit">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-brand-red/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                    <div class="relative z-10">
                        <h2 class="text-2xl font-bold mb-2">Send a Message</h2>
                        <p class="text-gray-500 mb-6">We typically respond within 24-48 hours.</p>
                        <form id="contact-form" class="space-y-5">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="first-name" class="block text-sm font-medium text-gray-400 mb-1.5">First Name <span class="text-brand-red">*</span></label>
                                    <input type="text" id="first-name" name="first-name" autocomplete="given-name" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-red transition-all placeholder-gray-600" placeholder="John">
                                </div>
                                <div>
                                    <label for="last-name" class="block text-sm font-medium text-gray-400 mb-1.5">Last Name <span class="text-brand-red">*</span></label>
                                    <input type="text" id="last-name" name="last-name" autocomplete="family-name" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-red transition-all placeholder-gray-600" placeholder="Doe">
                                </div>
                            </div>
                            <div>
                                <label for="email" class="block text-sm font-medium text-gray-400 mb-1.5">Email Address <span class="text-brand-red">*</span></label>
                                <input type="email" id="email" name="email" autocomplete="email" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-red transition-all placeholder-gray-600" placeholder="john@example.com">
                            </div>
                            <div>
                                <label for="topic" class="block text-sm font-medium text-gray-400 mb-1.5">Subject <span class="text-brand-red">*</span></label>
                                <select id="topic" name="topic" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-red transition-all">
                                    <option value="" disabled selected>Select a topic</option>
                                    <option value="general">General Inquiry</option>
                                    <option value="sponsorship">Corporate Sponsorship / CSI</option>
                                    <option value="donation">Making a Donation</option>
                                    <option value="volunteering">Volunteering</option>
                                    <option value="enrollment">Enrolling a Child</option>
                                    <option value="media">Media / Press Inquiry</option>
                                    <option value="visit">Scheduling a Visit</option>
                                </select>
                            </div>
                            <div>
                                <label for="message" class="block text-sm font-medium text-gray-400 mb-1.5">Message <span class="text-brand-red">*</span></label>
                                <textarea id="message" name="message" rows="4" required class="w-full bg-brand-black border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-red transition-all resize-none placeholder-gray-600" placeholder="How can we help?"></textarea>
                            </div>
                            <button type="submit" class="w-full bg-brand-red text-white font-bold py-3.5 rounded-lg hover:bg-white hover:text-brand-black transition-all flex items-center justify-center gap-2">
                                <span>Send Message</span>
                                <Send class="w-4 h-4" />
                            </button>
                        </form>
                        <p class="text-gray-500 text-xs mt-3 text-center">
                            Sending opens your email app with the message pre-filled and addressed to sipho@velokhaya.com.
                        </p>
                        <p id="contact-fallback" class="hidden text-brand-yellow text-sm mt-3 text-center">
                            If your email app didn't open, please email us directly at
                            <a href="mailto:sipho@velokhaya.com" class="underline">sipho@velokhaya.com</a>.
                        </p>
                        <p class="text-gray-600 text-xs mt-4 text-center">
                            By submitting, you agree to our <a href="/privacy-policy/" class="text-gray-500 hover:text-white underline">Privacy Policy</a>.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Social Connect - Compact -->
    <section class="py-12 bg-brand-dark border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col items-center justify-center gap-6 text-center">
                <div>
                    <h3 class="text-xl font-bold text-white">Follow Our Journey</h3>
                    <p class="text-gray-500 text-sm">Stay updated on the latest from Velokhaya</p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="https://www.facebook.com/Velokhaya/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="p-3 rounded-lg border border-white/10 hover:border-brand-blue/50 hover:bg-brand-blue/10 transition-all group">
                        <Facebook class="w-5 h-5 text-gray-500 group-hover:text-brand-blue transition-colors" />
                    </a>
                    <a href="https://x.com/Velokhaya" target="_blank" rel="noopener noreferrer" aria-label="X Twitter" class="p-3 rounded-lg border border-white/10 hover:border-white/30 hover:bg-white/5 transition-all group">
                        <Twitter class="w-5 h-5 text-gray-500 group-hover:text-white transition-colors" />
                    </a>
                    <a href="https://www.instagram.com/velokhaya_academy/?hl=en" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="p-3 rounded-lg border border-white/10 hover:border-brand-red/50 hover:bg-brand-red/10 transition-all group">
                        <Instagram class="w-5 h-5 text-gray-500 group-hover:text-brand-red transition-colors" />
                    </a>
                    <a href="https://www.linkedin.com/company/velokhaya/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 rounded-lg border border-white/10 hover:border-brand-blue/50 hover:bg-brand-blue/10 transition-all group">
                        <Linkedin class="w-5 h-5 text-gray-500 group-hover:text-brand-blue transition-colors" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-brand-black">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-2xl md:text-3xl font-bold mb-4">RIDE WITH <span class="text-brand-red">VELOKHAYA</span></h2>
            <p class="text-gray-500 mb-8 max-w-xl mx-auto">
                Behind every strong programme is a group of people who believe in consistency, discipline, and long term development.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <a href="/support/" class="px-6 py-3 bg-brand-red text-white font-bold rounded-full hover:bg-brand-blue hover:text-brand-black transition-all">
                    Support the Academy
                </a>
                <a href="/impact/" class="px-6 py-3 border border-white/20 text-white font-bold rounded-full hover:text-white hover:border-brand-red transition-all">
                    See Our Impact
                </a>
            </div>
        </div>
    </section>

    <script is:inline>
        (function () {
            var form = document.getElementById('contact-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var data = new FormData(form);
                var first = String(data.get('first-name') || '').trim();
                var last = String(data.get('last-name') || '').trim();
                var email = String(data.get('email') || '').trim();
                var message = String(data.get('message') || '').trim();
                var topicSelect = document.getElementById('topic');
                var topic = 'General Inquiry';
                if (topicSelect && topicSelect.selectedIndex >= 0) {
                    topic = topicSelect.options[topicSelect.selectedIndex].text;
                }
                var subject = 'Website enquiry — ' + topic;
                var body = message + '\n\n— ' + first + ' ' + last + '\n' + email;
                window.location.href = 'mailto:sipho@velokhaya.com' +
                    '?subject=' + encodeURIComponent(subject) +
                    '&body=' + encodeURIComponent(body);
                var fallback = document.getElementById('contact-fallback');
                if (fallback) fallback.classList.remove('hidden');
            });
        })();
    </script>
</BaseLayout>
