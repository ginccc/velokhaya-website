---

<footer class="bg-brand-black border-t border-white/5 py-12 md:py-16 text-gray-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 mb-10">
            <div>
                <img src="/images/logo.png" alt="Velokhaya Life Cycling Academy" class="h-12 mb-6">
                <p class="text-sm leading-relaxed mb-6">
                    Building Champions On and Off the Bike. Structured development through cycling, education,
                    and nutrition.
                </p>
                <div class="flex gap-4">
                    <a href="https://www.facebook.com/Velokhaya/" target="_blank" rel="noopener noreferrer"
                        aria-label="Follow us on Facebook"
                        class="text-gray-500 hover:text-white transition-colors"><i data-lucide="facebook"
                            class="w-5 h-5"></i></a>
                    <a href="https://x.com/Velokhaya" target="_blank" rel="noopener noreferrer"
                        aria-label="Follow us on X (Twitter)"
                        class="text-gray-500 hover:text-white transition-colors"><i data-lucide="twitter"
                            class="w-5 h-5"></i></a>
                    <a href="https://www.instagram.com/velokhaya_academy/?hl=en" target="_blank"
                        rel="noopener noreferrer" aria-label="Follow us on Instagram"
                        class="text-gray-500 hover:text-white transition-colors"><i data-lucide="instagram"
                            class="w-5 h-5"></i></a>
                    <a href="https://www.linkedin.com/company/velokhaya/" target="_blank" rel="noopener noreferrer"
                        aria-label="Follow us on LinkedIn"
                        class="text-gray-500 hover:text-white transition-colors"><i data-lucide="linkedin"
                            class="w-5 h-5"></i></a>
                </div>
            </div>

            <div>
                <h4 class="text-white font-bold mb-4 sm:mb-6">The Academy</h4>
                <ul class="space-y-4 text-sm">
                    <li><a href="/our-approach/" class="hover:text-brand-yellow transition-colors">Our Story</a></li>
                    <li><a href="/our-approach/#leadership"
                            class="hover:text-brand-yellow transition-colors">Leadership</a></li>
                    <li><a href="/impact/" class="hover:text-brand-yellow transition-colors">Impact Report</a>
                    </li>
                    <li><a href="/contact/" class="hover:text-brand-yellow transition-colors">Visit Us</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-bold mb-6">Our Pillars</h4>
                <ul class="space-y-4 text-sm">
                    <li><a href="/impact/" class="hover:text-brand-red transition-colors">Cycling Pathways</a>
                    </li>
                    <li><a href="/impact/" class="hover:text-brand-blue transition-colors">Education</a></li>
                    <li><a href="/impact/" class="hover:text-brand-yellow transition-colors">Nutrition</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-white font-bold mb-6">Legal & Trust</h4>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-center gap-2"><i data-lucide="shield-check"
                            class="w-4 h-4 text-brand-green"></i> Registered NPO</li>
                    <li class="flex items-center gap-2"><i data-lucide="shield-check"
                            class="w-4 h-4 text-brand-green"></i> PBO Status Approved</li>
                    <li class="flex items-center gap-2"><i data-lucide="file-text" class="w-4 h-4"></i> <a href="#"
                            class="hover:text-white underline decoration-gray-700 underline-offset-4">Privacy
                            Policy</a></li>
                    <li class="flex items-center gap-2"><i data-lucide="file-text" class="w-4 h-4"></i> <a href="#"
                            class="hover:text-white underline decoration-gray-700 underline-offset-4">Terms of
                            Use</a></li>
                </ul>
            </div>
        </div>
        <div
            class="border-t border-white/10 pt-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center">
            <p class="text-xs">&copy; 2026 Velokhaya Life Cycling Academy. All rights reserved.</p>
            <p class="text-xs mt-4 md:mt-0">Designed with purpose.</p>
        </div>
    </div>
</footer>
