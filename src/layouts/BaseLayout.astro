---
import '../styles/global.css';
import '../styles/cookie-consent.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import defaultOgImage from '../assets/images/hero-riders.jpg';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: ImageMetadata;
  /** Keep the page out of search results (e.g. the 404 page). Also drops the canonical link. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  ogImage = defaultOgImage,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).href;
// 1200x630 is the size Facebook, LinkedIn, and X expect for large link previews.
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImageUrl = new URL(og.src, Astro.site).href;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en-ZA" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords"
        content="Cycling Academy Cape Town, Velokhaya Khayelitsha, Sports Development NGO South Africa, High-Performance Cycling, Youth Development Khayelitsha, CSI Investment South Africa, B-BBEE Partner">
    <meta name="author" content="Velokhaya Life Cycling Academy">
    <meta name="geo.region" content="ZA-WC">
    <meta name="geo.placename" content="Khayelitsha, Cape Town">

    {noindex && <meta name="robots" content="noindex">}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Velokhaya Life Cycling Academy">
    <meta property="og:locale" content="en_ZA">
    {!noindex && <meta property="og:url" content={canonicalUrl}>}
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    {!noindex && <link rel="canonical" href={canonicalUrl}>}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <meta name="theme-color" content="#000000">
    <meta name="msapplication-TileColor" content="#000000">

    <!-- Preload only the upright face; italic is used in a couple of quotes and loads on demand. -->
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />

    <!-- Schema.org JSON-LD -->
    <slot name="schema" />
</head>

<body class="bg-brand-black text-white antialiased selection:bg-brand-red selection:text-white">

    <a href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand-yellow focus:text-brand-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold">
        Skip to content
    </a>

    <Header currentPath={currentPath} />

    <main id="main-content" tabindex="-1" class="focus:outline-none">
        <slot />
    </main>

    <Footer />

    <!-- Cookie consent (bundled; the analytics SDK is a lazy chunk loaded only after consent) -->
    <script src="../scripts/cookie-consent.ts"></script>

    <script is:inline>
        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');

        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                const isOpen = !mobileMenu.classList.toggle('hidden');
                if (menuIcon) menuIcon.classList.toggle('hidden', isOpen);
                if (closeIcon) closeIcon.classList.toggle('hidden', !isOpen);
                mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
                mobileMenuBtn.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
            });
        }

        // Navbar scroll effect
        const navbar = document.getElementById('main-nav');

        function updateNavbar() {
            const scrollThreshold = window.innerHeight - 100;

            if (navbar) {
                if (window.scrollY > scrollThreshold) {
                    navbar.classList.add('bg-brand-black/90', 'backdrop-blur-md', 'border-b', 'border-white/10');
                    navbar.classList.remove('bg-gradient-to-r', 'from-black', 'via-black/80', 'to-transparent');
                } else {
                    navbar.classList.remove('bg-brand-black/90', 'backdrop-blur-md', 'border-b', 'border-white/10');
                    navbar.classList.add('bg-gradient-to-r', 'from-black', 'via-black/80', 'to-transparent');
                }
            }
        }

        window.addEventListener('scroll', updateNavbar, { passive: true });
        window.addEventListener('resize', updateNavbar, { passive: true });
        updateNavbar();
    </script>
</body>

</html>
